{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ticket",
  "description": "A single civic issue report, from photo upload through resolution.",
  "type": "object",
  "required": ["id", "category_id", "lat", "lng", "photo_url", "created_at", "status", "department"],
  "properties": {
    "id": { "type": "string" },
    "category_id": { "type": "string", "description": "Matches an id in data/departments/taxonomy.json categories[]" },
    "lat": { "type": "number" },
    "lng": { "type": "number" },
    "photo_url": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["open", "acknowledged", "in_progress", "resolved", "disputed_closure", "escalated"]
    },
    "department": { "$ref": "./department.schema.json" },
    "duplicate_of": { "type": ["string", "null"], "description": "Ticket id this was merged into, if deduplicated" },
    "transfer_chain": {
      "type": "array",
      "description": "Every department hop, oldest first — the public accountability log",
      "items": {
        "type": "object",
        "required": ["department_name", "action", "timestamp"],
        "properties": {
          "department_name": { "type": "string" },
          "action": { "type": "string", "enum": ["received", "forwarded", "resolved", "reopened"] },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "resolution_photo_url": { "type": ["string", "null"] },
    "resolution_gps_distance_m": {
      "type": ["number", "null"],
      "description": "Distance between original and resolution-photo GPS/EXIF location — feeds the disputed-closure check"
    }
  }
}
