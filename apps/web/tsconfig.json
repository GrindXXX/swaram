{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],

      // Sibling workspaces. These resolve once the repo root gets a workspace
      // manifest; nothing in apps/web *statically* imports them today (see
      // lib/backend.ts for the lazy bridge into @swaram/backend), so the app
      // builds and demos standalone.
      "@swaram/shared/*": ["../../packages/shared/*"],
      "@swaram/backend/*": ["../../backend/core/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
