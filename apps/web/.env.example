# Supabase — the only backend. Anon key is what logged-out feed/issue reads use;
# RLS is the real boundary (technical-plan §07).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose. Used by route handlers that delegate to
# @swaram/backend domain functions.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin, used for OpenGraph URLs on the public issue page.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage bucket that signed upload URLs are minted against.
SUPABASE_MEDIA_BUCKET=issue-media
